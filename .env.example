APP_ENV=development
SECRET_KEY=attendai-super-secret-key-32chars-minimum-token
JWT_SECRET_KEY=attendai-jwt-secret-key-32chars-minimum-token

# Primary database: PostgreSQL
DATABASE_URL=postgresql+asyncpg://attendai:password@localhost:5432/attendai
# Fallback SQLite database for standalone local development/tests without docker
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./attendai.db

REDIS_URL=redis://localhost:6379/0

# LLM Configuration
# Options: nvidia | groq | gemini | mock
LLM_PROVIDER=mock

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-large-2407

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
LOG_LEVEL=INFO

WORKER_CONCURRENCY=2
UPLOAD_DIR=./uploads
